{
  "name": "seed-docs",
  "version": "1.0.0",
  "description": "Seed Protocol additions to Quartz: link grids, feature badges, logo page title and dark default theme",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
